{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arjun-knowledge-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": []
	},
	"limits": {
		"cpu_ms": 30000
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"KnowledgeMCP"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"OpenAIKnowledgeMCP"
			],
			"tag": "v2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "KnowledgeMCP",
				"name": "MCP_OBJECT"
			},
			{
				"class_name": "OpenAIKnowledgeMCP",
				"name": "OPENAI_MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "09b2d0da76a044489a9c334091d414f6"
		}
	],
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "VERSION_METADATA"
	},
	"workers_dev": true,
	"vars": {
		"SOURCE_FIRST_MODE": "on"
	},
	"routes": [
		{
			"pattern": "mcp.dancing-ganesh.com",
			"custom_domain": true
		}
	],
	"env": {
		"staging": {
			"name": "arjun-knowledge-mcp-staging",
			"workers_dev": true,
			"vars": {
				"DREAM_QUEUE_MODE": "live",
				"SOURCE_FIRST_MODE": "off"
			},
			"routes": [],
			"version_metadata": {
				"binding": "VERSION_METADATA"
			},
			"triggers": {
				"crons": []
			},
			"queues": {
				"producers": [
					{ "binding": "DREAM_MAINTENANCE_QUEUE", "queue": "pks-dream-maintenance-staging" }
				],
				"consumers": [
					{ "queue": "pks-dream-maintenance-staging", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "pks-dream-maintenance-staging-dlq" }
				]
			},
			"durable_objects": {
				"bindings": [
					{
						"class_name": "KnowledgeMCP",
						"name": "MCP_OBJECT"
					},
					{
						"class_name": "OpenAIKnowledgeMCP",
						"name": "OPENAI_MCP_OBJECT"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "b408f217d22348b195fa801bcda46aba"
				}
			]
		}
	}
}
