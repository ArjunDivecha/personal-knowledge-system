<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<!--
=============================================================================
LAUNCHD JOB: TWITTER / X NIGHTLY INGESTION
=============================================================================
Runs the Twitter ingestion pipeline every night at 2:00 AM.

Only NEW tweets (posted since the last run) are fetched each time —
the script stores the last-seen tweet ID in:
  ingestion/checkpoints/twitter_state.json

FIRST-TIME SETUP (run these commands in Terminal):
  1. Copy this file to the LaunchAgents folder:
       cp "<repo>/ingestion/twitter/com.arjun.knowledge-twitter.plist" \
          ~/Library/LaunchAgents/

  2. Load it so launchd picks it up:
       launchctl load ~/Library/LaunchAgents/com.arjun.knowledge-twitter.plist

  3. (Optional) Trigger a manual run right now to test:
       launchctl start com.arjun.knowledge-twitter

  4. Check it is registered:
       launchctl list | grep knowledge-twitter

TO UNLOAD (stop the nightly job):
  launchctl unload ~/Library/LaunchAgents/com.arjun.knowledge-twitter.plist

LOGS:
  stdout → ~/.knowledge_twitter_stdout.log
  stderr → ~/.knowledge_twitter_stderr.log

NOTE: The script reads credentials from:
  <repo>/ingestion/.env   (TWITTER_BEARER_TOKEN, TWITTER_USERNAME, etc.)
  plus the standard Upstash / OpenAI / Anthropic keys used by the rest
  of the ingestion pipeline.
=============================================================================
-->

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arjun.knowledge-twitter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/arjundivecha/Dropbox/AAA Backup/A Working/Memory/knowledge-system/ingestion/twitter/run.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/arjundivecha/Dropbox/AAA Backup/A Working/Memory/knowledge-system/ingestion</string>

    <!-- Run every night at 02:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Do NOT run at load — only on the schedule -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/arjundivecha/.knowledge_twitter_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/arjundivecha/.knowledge_twitter_stderr.log</string>

    <!-- Don't restart on failure -->
    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
